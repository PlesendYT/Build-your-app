-- Roguelike player (turn-based) for Defold
go.property("hp", 10)
go.property("atk", 3)
go.property("def", 1)
go.property("move_speed", 64)

local dungeon_ref = nil
local tile_size = 64
local turn_active = false

function init(self)
    dungeon_ref = msg.url("main:/dungeon_generator")
    msg.post(".", "acquire_input_focus")
    turn_active = true
end

function on_input(self, action_id, action)
    if not action.pressed or not turn_active then return end

    local dx, dy = 0, 0
    if action_id == hash("up") or action_id == hash("W") then dy = -1 end
    if action_id == hash("down") or action_id == hash("S") then dy = 1 end
    if action_id == hash("left") or action_id == hash("A") then dx = -1 end
    if action_id == hash("right") or action_id == hash("D") then dx = 1 end

    if dx == 0 and dy == 0 then return end

    local pos = go.get_position()
    local gx = math.floor(pos.x / tile_size) + dx
    local gy = math.floor(pos.y / tile_size) + dy

    -- Check walkable
    msg.post(dungeon_ref, "is_walkable", { gx = gx, gy = gy })

    -- Check for enemy at position
    local enemy = find_enemy_at(gx, gy)
    if enemy then
        -- Attack enemy
        local damage = math.max(1, self.atk + math.random(-1, 1))
        msg.post(enemy, "take_damage", { amount = damage })
        turn_active = false
    else
        -- Move
        msg.post(dungeon_ref, "is_walkable", { gx = gx, gy = gy })
        pos.x = gx * tile_size + tile_size / 2
        pos.y = gy * tile_size + tile_size / 2
        go.set_position(pos)
        turn_active = false
    end

    -- End turn
    msg.post("main:/enemy_manager", "enemy_turn")
end

function on_message(self, message_id, message, sender)
    if message_id == hash("set_position") then
        go.set_position(vmath.vector3(message.x, message.y, 0))
    elseif message_id == hash("take_damage") then
        local actual = math.max(1, message.amount - self.def)
        self.hp = self.hp - actual
        if self.hp <= 0 then
            msg.post("main:/game_manager", "player_died")
            go.delete()
        end
    elseif message_id == hash("player_turn") then
        turn_active = true
    end
end

function find_enemy_at(gx, gy)
    -- Simplified: check nearby enemy objects
    -- In practice, maintain an enemy grid reference
    return nil
end
