-- Enemy chase AI for Defold top-down
go.property("speed", 80)
go.property("chase_range", 250)
go.property("damage", 1)
go.property("hp", 3)

local player_pos = vmath.vector3()
local attack_cooldown = 0

function init(self)
    attack_cooldown = 0
end

function update(self, dt)
    -- Find player
    local player = msg.url("main:/player")
    if not player then return end

    local my_pos = go.get_position()

    -- Get player position via message
    msg.post(player, "get_position")
    -- In practice, store player ref and query directly

    local dist = vmath.length(player_pos - my_pos)

    if dist < self.chase_range then
        -- Chase player
        local dir = vmath.normalize(player_pos - my_pos)
        my_pos = my_pos + dir * self.speed * dt
        go.set_position(my_pos)

        -- Face movement direction
        if dir.x ~= 0 then
            go.set_scale(vmath.vector3(dir.x > 0 and 1 or -1, 1, 1), "#sprite")
        end

        -- Attack if close
        if dist < 40 and attack_cooldown <= 0 then
            msg.post(player, "take_damage", { amount = self.damage })
            attack_cooldown = 1.0
        end
    end

    if attack_cooldown > 0 then
        attack_cooldown = attack_cooldown - dt
    end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("player_position") then
        player_pos = message.position
    elseif message_id == hash("take_damage") then
        self.hp = self.hp - 1
        if self.hp <= 0 then
            go.delete()
        end
    end
end
