<!-- Threads listing page - shows all forum threads -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forum - Threads</title>
</head>
<body>
  <!-- Navigation with user info -->
  <nav>
    <a href="/threads">Forum</a>
    <div>
      <% if (typeof user !== 'undefined' && user) { %>
        <span><%= user.username %></span>
        <a href="/auth/logout">Logout</a>
      <% } else { %>
        <a href="/auth/login">Login</a>
        <a href="/auth/register">Register</a>
      <% } %>
    </div>
  </nav>

  <div class="container">
    <h1>Forum Threads</h1>
    <!-- Link to create a new thread if logged in -->
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/threads/new" class="btn">New Thread</a>
    <% } %>

    <!-- List of threads with title, author, and post count -->
    <div class="thread-list">
      <% if (threads.length === 0) { %>
        <p>No threads yet. Be the first to post!</p>
      <% } %>
      <% threads.forEach(thread => { %>
        <div class="thread-card">
          <h2><a href="/threads/<%= thread.id %>"><%= thread.title %></a></h2>
          <p class="meta">by <%= thread.username %> | <%= thread.postCount %> posts | <%= new Date(thread.createdAt).toLocaleDateString() %></p>
          <p><%= thread.content.substring(0, 200) %></p>
        </div>
      <% }) %>
    </div>
  </div>

  <style>
    /* Thread listing styles */
    .container { max-width: 800px; margin: 2rem auto; padding: 0 1rem; }
    .thread-card { background: white; padding: 1.5rem; margin: 1rem 0; border-radius: 8px; box-shadow: 0 1px 5px rgba(0,0,0,0.1); }
    .thread-card h2 { margin-bottom: 0.5rem; }
    .thread-card h2 a { color: #1f2937; text-decoration: none; }
    .meta { color: #6b7280; font-size: 0.85rem; margin-bottom: 0.5rem; }
    .btn { display: inline-block; background: #2563eb; color: white; padding: 0.5rem 1rem; border-radius: 4px; text-decoration: none; margin-bottom: 1rem; }
    nav { background: #1f2937; color: white; padding: 1rem 2rem; display: flex; justify-content: space-between; }
    nav a { color: white; text-decoration: none; margin-left: 1rem; }
  </style>
</body>
</html>
