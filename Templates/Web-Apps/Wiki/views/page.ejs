<!-- Single wiki page view with rendered markdown -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page.title %> - Wiki</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, sans-serif; background: #f8fafc; }
    nav { background: #1e293b; color: white; padding: 1rem 2rem; display: flex; justify-content: space-between; }
    nav a { color: white; text-decoration: none; }
    .container { max-width: 800px; margin: 2rem auto; padding: 0 1rem; }
    .page-content { background: white; padding: 2rem; border-radius: 8px; box-shadow: 0 1px 5px rgba(0,0,0,0.1); line-height: 1.8; }
    .page-content h1, .page-content h2 { margin: 1rem 0 0.5rem; }
    .page-content p { margin-bottom: 1rem; }
    .page-content code { background: #f1f5f9; padding: 0.2rem 0.4rem; border-radius: 4px; font-size: 0.9rem; }
    .page-content pre { background: #1e293b; color: #e2e8f0; padding: 1rem; border-radius: 8px; overflow-x: auto; margin: 1rem 0; }
    .actions { margin-top: 1rem; display: flex; gap: 0.5rem; }
    .btn { background: #2563eb; color: white; padding: 0.5rem 1rem; border-radius: 4px; text-decoration: none; font-size: 0.9rem; }
    .btn-secondary { background: #64748b; }
  </style>
</head>
<body>
  <nav>
    <a href="/"><strong>Wiki</strong></a>
  </nav>

  <div class="container">
    <!-- Rendered markdown content -->
    <div class="page-content">
      <%- html %>
    </div>
    <!-- Edit and history links -->
    <div class="actions">
      <a href="/<%= page.slug %>/edit" class="btn">Edit</a>
      <a href="/<%= page.slug %>/history" class="btn btn-secondary">History</a>
    </div>
  </div>
</body>
</html>
