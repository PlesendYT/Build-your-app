<!-- Auth starter home page -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Auth Starter</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, sans-serif; background: #f0f4f8; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; }
    .card { background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 20px rgba(0,0,0,0.1); text-align: center; max-width: 400px; }
    h1 { margin-bottom: 1rem; color: #1e293b; }
    p { margin-bottom: 1.5rem; color: #64748b; }
    .btn { display: inline-block; background: #2563eb; color: white; padding: 0.6rem 1.5rem; border-radius: 6px; text-decoration: none; margin: 0.25rem; }
    .btn-outline { background: transparent; border: 2px solid #2563eb; color: #2563eb; }
    .btn-outline:hover { background: #2563eb; color: white; }
  </style>
</head>
<body>
  <!-- Landing page with auth status -->
  <div class="card">
    <h1>Auth Starter</h1>
    <p>A complete authentication template with JWT, email verification, and password reset.</p>
    <% if (typeof user !== 'undefined' && user) { %>
      <p>Welcome, <strong><%= user.username %></strong>!</p>
      <a href="/dashboard" class="btn">Dashboard</a>
      <a href="/auth/logout" class="btn btn-outline">Logout</a>
    <% } else { %>
      <a href="/auth/login" class="btn">Login</a>
      <a href="/auth/register" class="btn btn-outline">Register</a>
    <% } %>
  </div>
</body>
</html>
