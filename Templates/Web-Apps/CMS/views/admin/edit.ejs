<!-- Admin content edit form -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content ? 'Edit: ' + content.title : 'New Content' %> - CMS Admin</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, sans-serif; background: #f8fafc; }
    nav { background: #1e293b; color: white; padding: 1rem 2rem; display: flex; justify-content: space-between; }
    nav a { color: white; text-decoration: none; }
    .container { max-width: 800px; margin: 2rem auto; padding: 0 1rem; }
    form { background: white; padding: 2rem; border-radius: 8px; box-shadow: 0 1px 5px rgba(0,0,0,0.1); }
    input, textarea { display: block; width: 100%; margin: 0.5rem 0; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 4px; }
    textarea { min-height: 300px; }
    label { display: flex; align-items: center; gap: 0.5rem; margin: 0.5rem 0; }
    label input { width: auto; }
    button { background: #2563eb; color: white; border: none; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer; }
    .error { color: #dc2626; margin-bottom: 1rem; }
  </style>
</head>
<body>
  <nav>
    <a href="/admin/dashboard">CMS Admin</a>
    <a href="/admin/logout">Logout</a>
  </nav>

  <div class="container">
    <!-- Content creation/editing form -->
    <% if (typeof error !== 'undefined' && error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <form action="/admin/content/<%= content ? content.id + '?_method=PUT' : '' %>" method="POST">
      <input type="text" name="title" placeholder="Content Title" value="<%= content ? content.title : '' %>" <%= content ? '' : 'required' %>>
      <textarea name="body" placeholder="Write content here..." required><%= content ? content.body : '' %></textarea>
      <label>
        <input type="checkbox" name="published" <%= content && content.published ? 'checked' : '' %>>
        Published
      </label>
      <button type="submit"><%= content ? 'Update' : 'Create' %></button>
    </form>
  </div>
</body>
</html>
