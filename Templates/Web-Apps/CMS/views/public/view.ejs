<!-- Public content view page -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content.title %> - CMS</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, sans-serif; background: #f8fafc; }
    header { background: #1e293b; color: white; padding: 1rem 2rem; display: flex; justify-content: space-between; }
    header a { color: white; text-decoration: none; }
    .container { max-width: 800px; margin: 2rem auto; padding: 0 1rem; }
    .content { background: white; padding: 2rem; border-radius: 8px; box-shadow: 0 1px 5px rgba(0,0,0,0.1); line-height: 1.8; }
    .content h1 { margin-bottom: 0.5rem; }
    .meta { color: #64748b; font-size: 0.85rem; margin-bottom: 1rem; }
  </style>
</head>
<body>
  <header>
    <a href="/"><strong>CMS</strong></a>
    <a href="/admin/login">Admin</a>
  </header>

  <div class="container">
    <div class="content">
      <h1><%= content.title %></h1>
      <p class="meta"><%= new Date(content.createdAt).toLocaleDateString() %></p>
      <div><%= content.body %></div>
    </div>
  </div>
</body>
</html>
